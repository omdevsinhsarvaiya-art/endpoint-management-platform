# Build context for the dashboard image is this directory. node_modules is the
# big one: npm ci reinstalls from the lockfile inside the image, so copying the
# host's tree in would be both slow and wrong (it may hold platform-specific
# binaries built for Windows).

node_modules/
dist/
.vite/
coverage/

**/.env
**/.env.*
!**/.env.example

npm-debug.log*
yarn-error.log*
pnpm-debug.log*

.git/
Dockerfile
.dockerignore
