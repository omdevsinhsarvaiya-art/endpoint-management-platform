{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // tests/ holds the cross-language guards: node-side checks that read repository
  // source off disk. They belong to this project because it is the one with node
  // types -- the app project deliberately has none, so nothing in the browser
  // bundle can reach for a node builtin and still typecheck.
  "include": ["vite.config.ts", "tests"]
}
