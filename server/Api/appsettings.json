{
  "//": [
    "No secrets belong in this file - it is committed to source control.",
    "Database:ConnectionString and Redis:ConnectionString are intentionally empty here.",
    "Supply them via environment variables (ENDPOINTPLATFORM_Database__ConnectionString)",
    "or user-secrets. Startup fails with an explanatory message if they are missing."
  ],
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "EnableSensitiveDataLogging": false,
    "MigrateOnStartup": false
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "endpointplatform:admin:",
    "ConnectTimeoutMs": 5000,
    "AbortOnConnectFail": false
  },
  "Seed": {
    "DefaultOrganizationName": "Default Organization",
    "DefaultOrganizationSlug": "default"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
