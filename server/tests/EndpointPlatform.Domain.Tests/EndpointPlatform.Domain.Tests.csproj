    <RootNamespace>EndpointPlatform.Domain.Tests</RootNamespace>
    <AssemblyName>EndpointPlatform.Domain.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\EndpointPlatform.Domain.csproj" />
