<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EndpointPlatform.Api.Tests</RootNamespace>
    <AssemblyName>EndpointPlatform.Api.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Api\EndpointPlatform.Api.csproj" />
    <ProjectReference Include="..\..\Migrations\EndpointPlatform.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory signing authority used to exercise the publish gate. Linked
         rather than referenced so this project does not depend on another test
         assembly; one file, one definition of what a signed test artifact is. -->
    <Compile Include="..\EndpointPlatform.Infrastructure.Tests\Agents\TestArtifacts.cs" Link="Agents\TestArtifacts.cs" />
  </ItemGroup>

</Project>
