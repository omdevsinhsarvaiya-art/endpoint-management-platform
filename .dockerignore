# Build context for the API images is the repository root, so everything the
# build does not need is excluded here. This keeps the context small and — more
# importantly — makes it impossible for a local secret or a stale build output
# to be copied into an image by accident.

# Local secrets. infra/.env is git-ignored; it must be docker-ignored too.
**/.env
**/.env.*
!**/.env.example
**/appsettings.Local.json
**/appsettings.*.Local.json
**/secrets.json
**/*.pfx
**/*.p12
**/*.key
**/*.pem
**/*.crt
**/certs/

# Local runtime state
agent-state/
.package-content/
infra/data/
**/*.agentcred

# Build output — the image rebuilds from source
**/bin/
**/obj/
**/dist/
**/node_modules/
**/TestResults/
artifacts/
publish/

# Nothing in the API images needs the agent, the tests or the dashboard
agent/
**/tests/
dashboard/

# Repository / tooling noise
.git/
.github/
.vs/
.vscode/
.idea/
docs/
*.md
!README.md
